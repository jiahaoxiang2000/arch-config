# Use explicit http:// addresses to avoid local TLS certificate setup.
# Add another block with a unique *.localhost name for each local server.
{
	# Keep the gateway private to this machine despite using host networking.
	default_bind 127.0.0.1
}

# Defense in depth for every local web route:
# - accept connections only from loopback clients;
# - accept browser requests only from that service's own origin;
# - permit requests without Origin for navigation and local CLI clients.
(local_request_guard) {
	@notLoopback {
		not remote_ip 127.0.0.1 ::1
	}
	respond @notLoopback "forbidden" 403

	@foreignOrigin {
		header Origin *
		not header Origin {args[0]}
	}
	respond @foreignOrigin "forbidden" 403
}

http://ikanban.localhost {
	route {
		import local_request_guard http://ikanban.localhost

		# DSH accepts API calls only from its own loopback origin.
		reverse_proxy 127.0.0.1:9090 {
			header_up Host 127.0.0.1:9090
			header_up Origin http://127.0.0.1:9090
		}
	}
}

http://iread.localhost {
	route {
		import local_request_guard http://iread.localhost
		reverse_proxy 127.0.0.1:9999
	}
}

http://daed.localhost {
	route {
		import local_request_guard http://daed.localhost
		reverse_proxy 127.0.0.1:2023
	}
}

http://agentsview.localhost {
	route {
		import local_request_guard http://agentsview.localhost

		# agentsview validates the Host header against its configured public URL.
		reverse_proxy 127.0.0.1:8585 {
			header_up Host 127.0.0.1:8585
		}
	}
}
