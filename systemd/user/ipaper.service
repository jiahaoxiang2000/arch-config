[Unit]
Description=IPaper DeepSeek Harness Server
After=network.target graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h
Environment="PATH=%h/.bun/bin:%h/.local/bin:%h/.nvm/versions/node/v24.12.0/bin:/usr/local/bin:/usr/bin"
Environment="DSH_HOME=%h/.ipaper"
Environment="SSH_AUTH_SOCK=%t/ssh-agent.socket"
EnvironmentFile=%h/.config/opencode/ikanban.env
ExecStart=/usr/bin/zsh -lc 'source %h/.zshrc; set -a; source %h/.token; set +a; export BASH_ENV=%h/.config/systemd/user/ikanban.bashenv; dsh --profile ipaper --port 9091'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
